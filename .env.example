# Copy to .env and fill in. Never commit .env (it is in .gitignore).
# Only needed for the LLM stages (text --ai sync, llm_topics). Every other stage runs offline.

# Any OpenAI-compatible chat-completions endpoint, e.g. the U-M GPT Toolkit.
LLM_API_BASE=
LLM_API_KEY=
# Model id as your endpoint lists it.
LLM_MODEL=
